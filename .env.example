# Browser-safe variables (readable in client and server code).
# Only values that are acceptable to expose publicly belong here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only variables (never prefix with NEXT_PUBLIC_).
# Put secrets in `.env.local`, which is gitignored.
# Optional inbound contact delivery. When unset, the contact form stays
# available but reports that delivery is not configured.
# CONTACT_WEBHOOK_URL=
# Optional salt used only to hash IPs in memory for analytics rate limiting.
# Raw IPs are never stored on events.
# ANALYTICS_HASH_SALT=
# Password for the hidden CMD analytics folder (`unlock analytics <password>`).
# Leave unset to keep the folder unavailable.
# ANALYTICS_VAULT_PASSWORD=

# Auth.js session signing secret (required for admin sign-in).
# Generate with: openssl rand -base64 32
# AUTH_SECRET=
# AUTH_TRUST_HOST=true
# Bootstrap admin identity for credentials sign-in.
# This email is also the first active administrator unless listed as inactive.
# ADMIN_EMAIL=
# bcrypt hash of the admin password. Generate with:
# npm run auth:hash-password -- <password>
# ADMIN_PASSWORD_HASH=
# Additional authorized administrator emails (comma-separated).
# These identities are authorized once they can authenticate; they do not share
# the bootstrap password. Do not put this value in client code.
# ADMIN_EMAILS=
# Administrators who must not access /admin (comma-separated).
# Inactive wins if an email is also listed in ADMIN_EMAIL or ADMIN_EMAILS.
# ADMIN_INACTIVE_EMAILS=

# MongoDB connection string for Prisma (server-only). Required in production
# before any database call. Include a database name. A replica set is required
# for Prisma interactive transactions (status history). Atlas provides one.
# Local single-node:
#   mongod --replSet rs0 --port 27017 --dbpath /data/db
#   mongosh --eval 'rs.initiate({_id:"rs0", members:[{_id:0, host:"127.0.0.1:27017"}]})'
# DATABASE_URL="mongodb://127.0.0.1:27017/portfolio?replicaSet=rs0"
