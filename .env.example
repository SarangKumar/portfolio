# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# Leave these empty to run the site on the bundled seed content (src/content/seed.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The only Google account allowed into /admin. Must match the email in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAIL=sarangkumar1578@gmail.com

# Public origin used for canonical URLs, sitemap, robots, OG and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
