rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with NEXT_PUBLIC_ADMIN_EMAIL.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'sarangkumar1578@gmail.com';
    }

    // Site configuration: public read, admin write.
    // config/site and config/resume
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content collections: the public sees only published docs.
    match /{col}/{docId} {
      allow read: if isAdmin()
        || (col in ['projects','posts','experience','books','bookmarks','notes','skills','diagrams']
            && resource.data.status == 'published');
      allow write: if isAdmin()
        && col in ['projects','posts','experience','books','bookmarks','notes','skills','diagrams'];
    }

    // Public board: anyone may submit a pending comment; only approved ones are readable.
    match /comments/{id} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if request.resource.data.keys().hasOnly(['name','message','createdAt','status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is string;
      allow update, delete: if isAdmin();
    }
  }
}
