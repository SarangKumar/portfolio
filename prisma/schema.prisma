generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  active
  inactive
}

enum PublicationStatus {
  draft
  published
  archived
}

/// Persistence shape for the Story 2 administrator identity.
/// Authorization still reads the env directory; this collection is the
/// MongoDB representation of that model. `identityId` matches the Auth.js
/// user id (`stableIdentityId`). MongoDB `_id` stays a native ObjectId.
model Admin {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  identityId String      @unique
  email      String      @unique
  status     AdminStatus
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("admins")
}

type ProjectMedia {
  src    String
  alt    String
  width  Int?
  height Int?
  kind   String?
}

type ProjectCaseStudySection {
  key   String
  title String
  body  String
}

type BlogCoverImage {
  src String
  alt String
}

model SkillCategory {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  key       String            @unique
  label     String
  sortOrder Int               @default(0)
  status    PublicationStatus @default(published)
  skills    Skill[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@map("skill_categories")
}

model Skill {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  key        String            @unique
  name       String
  categoryId String            @db.ObjectId
  category   SkillCategory     @relation(fields: [categoryId], references: [id])
  status     PublicationStatus @default(published)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status])
  @@index([categoryId])
  @@map("skills")
}

model Project {
  id                  String                    @id @default(auto()) @map("_id") @db.ObjectId
  key                 String                    @unique
  slug                String                    @unique
  title               String
  summary             String
  description         String?
  technologies        String[]
  skillKeys           String[]
  githubUrl           String?
  demoUrl             String?
  media               ProjectMedia[]
  architecture        String?
  problem             String?
  solution            String?
  challenges          String?
  decisions           String?
  tradeoffs           String?
  testing             String?
  performance         String?
  futureImprovements  String?
  sections            ProjectCaseStudySection[]
  experienceKeys      String[]
  status              PublicationStatus         @default(draft)
  publishedAt         DateTime?
  internalNotes       String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([status])
  @@map("projects")
}

model Experience {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  key           String            @unique
  company       String
  role          String
  startDate     String
  endDate       String?
  description   String?
  technologies  String[]
  skillKeys     String[]
  projectKeys   String[]
  achievements  String[]
  status        PublicationStatus @default(draft)
  sortOrder     Int               @default(0)
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@map("experience")
}

model BlogPost {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  slug          String            @unique
  title         String
  summary       String
  content       String
  publishedAt   DateTime
  updatedAt     DateTime?
  tags          String[]
  categories    String[]
  coverImage    BlogCoverImage?
  status        PublicationStatus @default(draft)
  internalNotes String?
  createdAt     DateTime          @default(now())

  @@index([status])
  @@map("blog_posts")
}

model ResumeVersion {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  key           String            @unique
  label         String
  targetType    String
  overview      String?
  notes         String?
  previewSrc    String?
  previewKind   String?
  fileSrc       String?
  fileName      String?
  isDefault     Boolean           @default(false)
  status        PublicationStatus @default(draft)
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@map("resume_versions")
}

model Certification {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  key              String            @unique
  name             String
  issuer           String
  issuedOn         String?
  credentialId     String?
  verificationUrl  String?
  mediaSrc         String?
  skillKeys        String[]
  status           PublicationStatus @default(draft)
  internalNotes    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@map("certifications")
}

model Badge {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  key             String            @unique
  name            String
  issuer          String
  issuedOn        String?
  verificationUrl String?
  imageSrc        String?
  skillKeys       String[]
  status          PublicationStatus @default(draft)
  internalNotes   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@map("badges")
}
